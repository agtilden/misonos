# Copy to .env and fill in. docker compose reads this automatically.

# LAN IP of THIS docker host that your Sonos speakers can reach.
# NOT the Tailscale 100.x address. Find it with:  ip -4 addr show | grep 192.168
MISONOS_LAN_IP=192.168.68.50

# Optional Phish.in API key (leave blank if you don't have one).
MISONOS_PHISH_API_KEY=

# Optional Navidrome (or any Subsonic-compatible) library. Leave blank to hide
# the source. A dedicated non-admin Navidrome user is enough. The services use
# host networking, so the URL must work from the host itself — e.g.
# http://127.0.0.1:4533 with Navidrome's port published — not a Docker service name.
MISONOS_NAVIDROME_SERVER_URL=
MISONOS_NAVIDROME_USER=
MISONOS_NAVIDROME_PASSWORD=
